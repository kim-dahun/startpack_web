<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty scope="context" name="SERVER_PORT" source="server.port" defaultValue="9093"/>
    <springProperty scope="context" name="ROOT_LOG_LEVEL" source="logging.level.root" defaultValue="INFO"/>
    <springProperty scope="context" name="JPA_SQL_LOG_LEVEL" source="logging.level.org.hibernate.SQL" defaultValue="DEBUG"/>
    <springProperty scope="context" name="JPA_BIND_LOG_LEVEL" source="logging.level.org.hibernate.orm.jdbc.bind" defaultValue="TRACE"/>
    <timestamp key="LOG_DATE" datePattern="yyyy-MM-dd"/>

    <property name="LOG_PATH" value="logs/${SERVER_PORT}"/>
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${LOG_DATE}.log</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/archive/%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
    </appender>

    <logger name="com.upmudoum.user.common.web.ApiAccessLogFilter" level="INFO"/>
    <logger name="com.upmudoum.user.domain.auth" level="INFO"/>
    <logger name="org.hibernate.SQL" level="${JPA_SQL_LOG_LEVEL}"/>
    <logger name="org.hibernate.orm.jdbc.bind" level="${JPA_BIND_LOG_LEVEL}"/>

    <root level="${ROOT_LOG_LEVEL}">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
